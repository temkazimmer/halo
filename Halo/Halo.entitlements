<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandboxed from commit #1 — see HALO_PLAN §7.1.
	     Add nothing else here. There is no screen-capture entitlement:
	     ScreenCaptureKit is gated purely by TCC, and App Store ingestion rejects
	     unrecognised com.apple.security.* keys even though they work locally. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
